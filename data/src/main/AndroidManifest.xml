<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- GeminiLlmClient makes HTTPS calls; merged into the app manifest. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- AndroidNetworkAvailability asks whether the network is validated before Point goes
         outside (#690, #691); normal-protection, granted at install; merged into the app manifest. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 11+ package visibility: so queryIntentActivities can list the installed apps
         that open/send an object (#66 device actions). We only see VIEW/SEND handlers. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="*/*" />
        </intent>

        <!-- Есть ли на устройстве календарь (#1131): без объявления Android 11+ отвечает
             «никого нет», даже когда календарь стоит, — и честное слово до чужого экрана
             превратилось бы в ложный отказ. -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>

    <application>
        <!-- Exposes scratch files to other apps for Share as content:// Uris.
             Authority resolves to "<applicationId>.fileprovider" at manifest merge. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/point_file_paths" />
        </provider>
    </application>
</manifest>
