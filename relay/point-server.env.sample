# Образец окружения службы сервера аккаунтов (#471). Настоящий файл — ТОЛЬКО на сервере,
# в репозиторий он не попадает никогда (см. .gitignore).
#
# Весь смысл выбранного потока входа в том, что учётные данные Google держит сервер:
# в APK и MSI их нет и быть не может.

# Публичный адрес сервера. Не секрет — он станет константой сборки клиентов.
POINT_SERVER_URL=https://point.leerio.app

# Где лежит база (SQLite в режиме WAL).
POINT_SERVER_ROOT=/home/point/point-server

# Слушаем только петлю: TLS терминирует Caddy (срез #470), снаружи сервер не виден.
POINT_SERVER_HOST=127.0.0.1
POINT_SERVER_PORT=8080

# Клиент Google OAuth типа «Web application» того же проекта GCP.
# redirect_uri в консоли Google обязан быть ровно https://point.leerio.app/auth/callback
POINT_GOOGLE_CLIENT_ID=
POINT_GOOGLE_CLIENT_SECRET=

# Стук в телефон (#817): путь к ключу служебной учётки Firebase на этом сервере.
# Ключ приватный — в репозитории его нет и быть не может, кладётся рядом с окружением
# службы и читается только ею. Пусто — Point работает без стука: просьба компьютера
# разбирается, когда человек откроет Point сам.
POINT_FCM_KEY=/home/point/point-server/firebase-admin.json

# Ключ, которым настройки аккаунта (ключи сервисов человека) зашифрованы на диске.
# Пусто — settings.key в POINT_SERVER_ROOT; файла нет — сервер создаёт его сам при запуске
# и дальше только читает. Файл держать отдельно от резервных копий базы: копия базы без
# него ключей людей не раскрывает. Пропал файл — настройки читаются как «их нет», и
# устройства кладут свои заново.
POINT_SETTINGS_KEY_FILE=

# AI без своего ключа — пробные действия (#477). Только Groq и Cloudflare Workers AI: оба
# письменно обещают не учиться на присланном (point_server/ai.py). Пусто — пробы нет, телефон
# её не предлагает. Кладёт tools/server-ai-keys.sh, не показывая значений.
POINT_AI_GROQ_KEY=
POINT_AI_CLOUDFLARE_KEY=
POINT_AI_CLOUDFLARE_ACCOUNT=
# Пробных действий на аккаунт и сколько сервер отдаёт за сутки на всех (предел денег).
POINT_AI_TRIAL=30
POINT_AI_DAILY_CAP=500
