# Образец окружения службы сервера аккаунтов (#471). Настоящий файл — ТОЛЬКО на сервере,
# в репозиторий он не попадает никогда (см. .gitignore).
#
# Весь смысл выбранного потока входа в том, что учётные данные Google держит сервер:
# в APK и MSI их нет и быть не может.

# Публичный адрес сервера. Не секрет — он станет константой сборки клиентов.
POINT_SERVER_URL=https://point.leerio.app

# Где лежит база (SQLite в режиме WAL).
POINT_SERVER_ROOT=/home/point/point-server

# Слушаем только петлю: TLS терминирует Caddy (срез #470), снаружи сервер не виден.
POINT_SERVER_HOST=127.0.0.1
POINT_SERVER_PORT=8080

# Клиент Google OAuth типа «Web application» того же проекта GCP.
# redirect_uri в консоли Google обязан быть ровно https://point.leerio.app/auth/callback
POINT_GOOGLE_CLIENT_ID=
POINT_GOOGLE_CLIENT_SECRET=
