<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name=".PointApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Point">

        <!-- Home / launcher: recent objects (History). Point is now a place you
             open to continue working with an object, not only a share target. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Scan the PC's pairing QR with any camera → opens Point and pairs (the token
                 rides in the point-pc:// URI, so no round-trip to the PC is needed). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="point-pc" />
            </intent-filter>
        </activity>

        <!--
          ShareActivity receives Android Share for the MVP object types — the
          other entry point beside the HomeActivity launcher above.
          (A debug-only SandboxActivity with a launcher icon is added by the
          `debug` source set for testing without re-sharing / re-flashing.)
        -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/uri-list" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/zip" />
            </intent-filter>
            <!-- Several files at once (e.g. multi-photo) -> a COLLECTION in Point. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!--
          "Right-click for text": PROCESS_TEXT puts Point in the text-selection toolbar of
          every app. Selecting text anywhere and tapping Point opens the flow on that text.
        -->
        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>
</manifest>
