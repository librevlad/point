<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY overlay. Adds a launcher icon (SandboxActivity) so you can drive the
  real flow from sample objects without sharing a file. Not present in release.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!--
          Экран выбора источника открывается плиткой из шторки, а плитку человек добавляет руками —
          поэтому проверить поток с машины иначе нечем: неэкспортированную активити adb запускать
          не даёт. В debug она экспортируется, в release остаётся закрытой (#246).
        -->
        <activity
            android:name=".source.SourcePickerActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <!-- Проба принтера (#251): в образе эмулятора печатать нечем, а без живого задания
             «Point как принтер» пришлось бы сдавать непроверенным. -->
        <activity
            android:name=".PrintProbeActivity"
            android:exported="true"
            android:excludeFromRecents="true" />

        <activity
            android:name=".SandboxActivity"
            android:exported="true"
            android:icon="@android:drawable/sym_def_app_icon"
            android:label="Point Sandbox">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
