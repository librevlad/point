# Normalize line endings: LF in the repository, native on checkout.
* text=auto

*.kt          text eol=lf
*.kts         text eol=lf
*.java        text eol=lf
*.xml         text eol=lf
*.md          text eol=lf
*.toml        text eol=lf
*.pro         text eol=lf
*.properties  text eol=lf
gradlew       text eol=lf

# Windows batch scripts need CRLF.
*.bat         text eol=crlf

# Binary assets — never touch.
*.jar         binary
*.png         binary
*.jpg         binary
*.webp        binary
*.jks         binary
*.keystore    binary
