# Normalize line endings: LF in the repository, native on checkout.
* text=auto

*.kt          text eol=lf
*.kts         text eol=lf
*.java        text eol=lf
*.xml         text eol=lf
*.md          text eol=lf
*.toml        text eol=lf
*.pro         text eol=lf
*.properties  text eol=lf
*.sh          text eol=lf
gradlew       text eol=lf

# Windows batch scripts need CRLF.
*.bat         text eol=crlf

# Binary assets — never touch.
*.jar         binary
*.png         binary
*.jpg         binary
*.webp        binary
*.jks         binary
*.keystore    binary

# Дословный вывод OCR с устройства — фикстуры должны оставаться побайтово теми же
# на Windows и на CI, иначе тест сверяется не с тем, что выдал телефон.
core/flow/src/test/resources/ocr/*.txt -text eol=lf
executors/src/test/resources/ocr/*.tsv -text eol=lf

# Счётчик таблиц корпуса (#262): awk-программу и эталоны читают awk и шелл, а не JVM. CRLF в них
# уезжает в разбор молча — ровно та тихая порча, от которой сама метрика и лечит.
*.awk               text eol=lf
tools/corpus/*.tsv  text eol=lf
