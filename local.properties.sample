# Copy this file to `local.properties` (which is git-ignored) and fill it in.
# Android Studio also writes sdk.dir here automatically on first open.

# Android SDK location:
sdk.dir=C\:\\Users\\User\\AppData\\Local\\Android\\Sdk

# Primary AI — Gemini. Surfaced via BuildConfig.GEMINI_API_KEY (see :data).
# Never hard-code this in source and never commit the real local.properties.
GEMINI_API_KEY=PUT_YOUR_KEY_HERE

# Fallback #1 — Claude (Anthropic), tried after Gemini. Native Messages API.
# Leave ANTHROPIC_API_KEY blank to disable. Model defaults to claude-opus-4-8;
# set CLAUDE_MODEL=claude-haiku-4-5 (or claude-sonnet-5) for a cheaper option.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-opus-4-8

# Fallback #2 — OpenAI-compatible (OpenAI, OpenRouter, or a local server).
# Leave OPENAI_API_KEY blank to disable.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Free OpenAI-compatible providers (#32). Fill any/all — each activates when its
# key is set, and the chain tries them before Gemini (which rate-limits). Sign-up
# is ~a minute each. Vision-capable ones (OpenRouter/Groq/Mistral) lead the chain
# so "Понять" works on a photo; models below are sensible defaults — override freely.

# OpenRouter — one key, many free models (…:free).  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# Groq — very fast, generous free tier.  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral — free tier, pixtral is multimodal.  https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=pixtral-12b-2409

# Cerebras — very fast, text-only.  https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama-3.3-70b
