# Copy this file to `local.properties` (which is git-ignored) and fill it in.
# Android Studio also writes sdk.dir here automatically on first open.

# Android SDK location:
sdk.dir=C\:\\Users\\User\\AppData\\Local\\Android\\Sdk

# Gemini (Google AI Studio). Key: https://aistudio.google.com/apikey — never commit
# the real local.properties. GEMINI_MODELS is a comma-separated fallback list; the
# pinned gemini-2.0-flash has zero free quota (429), so serving aliases lead.
GEMINI_API_KEY=PUT_YOUR_KEY_HERE
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-pro-latest

# Fallback #1 — Claude (Anthropic), tried after Gemini. Native Messages API.
# Leave ANTHROPIC_API_KEY blank to disable. Model defaults to claude-opus-4-8;
# set CLAUDE_MODEL=claude-haiku-4-5 (or claude-sonnet-5) for a cheaper option.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-opus-4-8

# Fallback #2 — OpenAI-compatible (OpenAI, OpenRouter, or a local server).
# Leave OPENAI_API_KEY blank to disable. *_MODELS is a comma-separated fallback list.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=gpt-4o-mini

# Free OpenAI-compatible providers (#32). Fill any/all — each activates when its key
# is set, and the chain tries them before Gemini (which rate-limits). Sign-up is ~a
# minute each. *_MODELS is comma-separated, so ONE key (esp. OpenRouter) chains
# several free models — if one is rate-limited, the next is tried. Vision-capable
# models lead so "Понять" works on a photo; defaults are sensible — override freely.

# OpenRouter — one key, many free models (…:free).  https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free

# Groq — very fast, generous free tier.  https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,llama-3.1-8b-instant
# Тем же ключом — расшифровка голосового (#223): отдельная ручка /audio/transcriptions
# и отдельная модель. Первый движок расшифровки: украинскую речь читает дословно и даром.
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Mistral — free tier, pixtral is multimodal.  https://console.mistral.ai
# ЭТОТ ЖЕ КЛЮЧ включает «внешний глаз» (#280) — специальную ручку чтения страницы
# `mistral-ocr-latest`. По замеру 04.08.2026 (docs/VISION-MODELS.md) она читает печатную кириллицу
# дословно: 24 строки ведомости из 24 на чистом кадре, под углом, в тени и при плохом свете, 1,3–5 с.
# Ключ пуст — глаза нет, приложение работает офлайновым OCR как раньше. Адресат: Mistral, Франция (ЕС).
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODELS=pixtral-12b-2409,mistral-medium-latest,mistral-small-latest

# OVH — второй «внешний глаз»: зрячая модель БЕЗ ключа и регистрации (15/15 на кириллице,
# замер разведки 04.08.2026), сервер во Франции, порядка двух запросов в минуту.
# Ключ здесь НЕОБЯЗАТЕЛЕН: пустой — читатель всё равно работает, заданный — поднимает лимиты.
OVH_API_KEY=
OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_MODEL=Qwen2.5-VL-72B-Instruct

# Cerebras — very fast. Free tier needs a plan enabled in the billing tab.  https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODELS=gpt-oss-120b

# GitHub Models — free during preview, generous, vision (gpt-4o). Token with the
# "models" permission: https://github.com/settings/tokens  (fine-grained or classic)
GITHUB_API_KEY=
GITHUB_BASE_URL=https://models.github.ai/inference
# GitHub Models закрыт (410 на 02.08.2026) — вернут, впишите модели сюда
GITHUB_MODELS=

# Второй читатель страницы (#280) — БЕСПЛАТНЫЕ сервисы (про карту — у каждого ниже отдельно).
# Оба необязательны: пустой ключ = слоя нет, приложение работает офлайновым OCR как раньше.
# Слой пишется в свой ключ метаданных (cloud.atoms.ref) и НЕ затирает офлайновое чтение —
# смысл именно в двух независимых чтениях одного кадра.
# Azure Document Intelligence сюда не приехал сознательно: он требует карту.

# Unstructured — план «Let's Go»: 15 000 страниц/мес, сбрасывается ежемесячно, карта не нужна
# (так написано на https://unstructured.io/pricing на 02.08.2026). Sign up → API Keys.
# ВАЖНО: на той же вкладке рядом с ключом показан API URL, и у аккаунта он может быть СВОЙ —
# скопируйте оттуда. Значение ниже лишь запасное, и чужой адрес даёт 401/404, а не подсказку.
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general

# LlamaParse (LlamaCloud) — бесплатный план «Includes 10K credits» в месяц
# (llamaindex.ai/pricing, 02.08.2026). Кредиты — НЕ страницы: сколько кредитов стоит страница,
# зависит от тарифа разбора, так что 10K не равны 10 000 снимков.
# Про карту на этой странице НЕ написано ничего — если при
# регистрации попросят привязать карту, не привязывайте и оставьте ключ пустым, слоя просто не
# будет. https://cloud.llamaindex.ai → API Keys.
# LLAMA_CLOUD_TIER: cost_effective (по умолчанию — дешевле всего из тех, кто вообще читает
# снимок) | agentic | agentic_plus — сильнее, но месячная квота уходит заметно быстрее. Есть ещё
# fast: он дешевле всех, но правило-ориентированный и фотографию страницы не читает вовсе.
# Язык страницы (ru+en) шлётся кодом сам — здесь его задавать не нужно.
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_BASE_URL=https://api.cloud.llamaindex.ai
LLAMA_CLOUD_TIER=cost_effective

# Адрес сервера Point (#472/#473) — необязательное переопределение для своих опытов.
# Пусто — берётся `PointServer.DEFAULT_URL`. Секретом не является: вход идёт по аккаунту
# Google, и пропуск у каждого устройства свой. Общего `RELAY_APP_SECRET` больше не существует (#419).
# Компьютер читает свой адрес из `~/.point-pc/config` (ключ `server`), а не отсюда.
RELAY_URL=

# Живой прогон сетевых тестов `:desktop` (#473) — СВОЙСТВАМИ ЗАПУСКА, не отсюда:
#   ./gradlew :desktop:test -Dpoint.test.server=https://point.leerio.app -Dpoint.test.pass=<пропуск>
# Нет свойств — тесты сами себя пропускают, как на CI.

# Release signing (#11): absolute path to the keystore + its passwords.
# Generate once (keytool -genkeypair), store OUTSIDE the repo, BACK IT UP -
# losing it means losing the Play identity of the app.
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=

# Point как Telegram-бот (#92): токен от @BotFather. Без него :bot:run не стартует.
# Бот переиспользует GEMINI_API_KEY выше для AI-действий (Понять/Перевести/Собрать).
TELEGRAM_BOT_TOKEN=PUT_YOUR_BOTFATHER_TOKEN_HERE
